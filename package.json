{
  "name": "viblooop",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "start:pwa": "npx http-server -p 8080 -c-1 dist/viblooop/browser/en-US",
    "start-with-locale": "ng serve --configuration=fr",
    "start:network": "ng serve --host 0.0.0.0 --port 4200",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "verify:design": "npm run lint:styles && npm run build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "extract-i18n-text": "ng extract-i18n --output-path src/locale --out-file source.xlf",
    "serve:ssr:viblooop": "node dist/viblooop/server/server.mjs"
  },
  "private": true,
