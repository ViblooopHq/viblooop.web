# API Configuration
# Local dev defaults to http://localhost:8000 (can be overridden with LOCAL_API_BASE_URL)
LOCAL_API_BASE_URL=http://localhost:8000
# Production build defaults to https://api.viblooop.com (can be overridden with API_BASE_URL or PROD_API_BASE_URL)
API_BASE_URL=https://api.viblooop.com

# Firebase Web Client Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# VAPID Key for Push Notifications
VAPID_PUBLIC_KEY=

# Meta & Host URLs
OG_IMAGE_URL=https://www.viblooop.com/og.png
OG_PAGE_URL=https://www.viblooop.com
LOCAL_OG_PAGE_URL=http://localhost:4200
